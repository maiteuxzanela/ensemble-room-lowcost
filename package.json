{
  "name": "ensemble-room-lowcost",
  "version": "0.18.3",
  "description": "OpenCode Ensemble Hardened - Low-cost multi-agent runtime with native standby, silent lead, and deterministic board wake",
  "types": "./src/index.ts",
  "module": "dist/index.js",
  "main": "dist/index.js",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./rpc": {
      "types": "./src/rpc.ts",
      "import": "./dist/rpc.js",
      "default": "./dist/rpc.js"
    },
    "./tui": {
      "types": "./src/tui.tsx",
      "import": "./dist/tui.js",
      "default": "./dist/tui.js"
    },
    "./package.json": "./package.json"
  },
  "type": "module",
  "license": "MIT",
  "author": "Maiteux Zanela",
  "homepage": "https://github.com/maiteuxzanela/ensemble-room-lowcost#readme",
  "bugs": {
    "url": "https://github.com/maiteuxzanela/ensemble-room-lowcost/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/maiteuxzanela/ensemble-room-lowcost.git"
  },
  "keywords": [
    "opencode",
    "plugin",
    "agent",
    "team",
    "multi-agent",
    "parallel",
    "orchestration",
    "standby",
    "silent-lead",
    "watchdog",
    "low-cost"
  ],
  "files": [
    "dist",
    "src",
    "tsconfig.json",
    "LICENSE",
    "README.md",
    "CHANGELOG.md",
    "SECURITY.md",
    "social-preview.png"
  ],
  "scripts": {
    "test": "node tests/run_all.mjs",
    "check": "node --check dist/index.js && node --check dist/rpc.js && node --check dist/tui.js",
    "typecheck": "tsc --noEmit",
    "build": "esbuild src/index.ts src/rpc.ts src/tui.tsx --bundle --platform=node --format=esm --packages=external --outdir=dist"
  },
  "engines": {
    "node": ">=22.23.4",
    "bun": ">=1.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.9",
    "@opentui/core": "0.5.10",
    "@opentui/solid": "0.5.10",
    "@types/bun": "^1.4.3",
    "@types/node": "^26.6.4",
    "esbuild": "^0.28.2",
    "solid-js": "1.9.12",
    "typescript": "~5.8.3"
  },
  "peerDependencies": {
    "@opentui/core": ">=0.5.10",
    "@opentui/solid": ">=0.5.10",
    "solid-js": ">=1.9.0",
    "typescript": "^5.0.0"
  },
  "peerDependenciesMeta": {
    "@opentui/core": {
      "optional": true
    },
    "@opentui/solid": {
      "optional": true
    },
    "solid-js": {
      "optional": true
    },
    "typescript": {
      "optional": true
    }
  },
  "dependencies": {
    "@opencode-ai/plugin": "^1.17.18",
    "@opencode-ai/sdk": "^1.17.18",
    "@opencode/plugin": "2.0.16"
  },
  "overrides": {
    "@babel/core": "7.29.7",
    "seroval": "1.6.11",
    "seroval-plugins": "1.6.11"
  }
}
