{
  "name": "@maiteuxzanela/ensemble-room-lowcost",
  "version": "0.18.1",
  "description": "OpenCode Ensemble Hardened - Low-cost multi-agent runtime with native standby, silent lead, and deterministic board wake",
  "module": "src/index.ts",
  "main": "dist/index.js",
  "exports": {
    ".": "./src/index.ts",
    "./rpc": "./src/rpc.ts",
    "./tui": "./src/tui.tsx"
  },
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/maiteuxzanela/ensemble-room-lowcost.git"
  },
  "keywords": [
    "opencode",
    "plugin",
    "agent",
    "team",
    "multi-agent",
    "parallel",
    "orchestration",
    "standby",
    "silent-lead",
    "watchdog",
    "low-cost"
  ],
  "files": [
    "dist",
    "src",
    "tests",
    "tsconfig.json",
    "LICENSE",
    "README.md",
    "social-preview.png"
  ],
  "scripts": {
    "test": "node tests/run_all.mjs",
    "check": "node --check dist/index.js",
    "typecheck": "tsc --noEmit",
    "build": "esbuild src/index.ts --bundle --platform=node --format=esm --outfile=dist/index.js"
  },
  "engines": {
    "node": ">=24",
    "bun": ">=1.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.9",
    "@opentui/core": "0.5.10",
    "@opentui/solid": "0.5.10",
    "@types/bun": "latest",
    "solid-js": "1.9.0",
    "typescript": "^7.0.2"
  },
  "peerDependencies": {
    "@opentui/core": ">=0.5.10",
    "@opentui/solid": ">=0.5.10",
    "solid-js": ">=1.9.0",
    "typescript": "^5"
  },
  "dependencies": {
    "@opencode-ai/plugin": "^1.17.18",
    "@opencode-ai/sdk": "^1.17.18",
    "@opencode/plugin": "2.0.3"
  }
}
